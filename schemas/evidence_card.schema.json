{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://protocolo-his.local/schemas/evidence-card.schema.json",
  "title": "Cartao de evidencia do Protocolo HIS",
  "type": "object",
  "required": [
    "application_id",
    "variable_id",
    "document_id",
    "article_id",
    "evidence_type",
    "source_excerpt",
    "interpretation",
    "source_trace"
  ],
  "properties": {
    "application_id": {"type": "string", "minLength": 1},
    "variable_id": {"type": "string", "pattern": "^[A-Z]{2,3}_[0-9]{2}$"},
    "document_id": {"type": "string", "minLength": 1},
    "article_id": {"type": "string", "minLength": 1},
    "evidence_type": {
      "type": "string",
      "enum": [
        "central",
        "complementary",
        "negative",
        "definition",
        "reference",
        "dependency",
        "conflict",
        "context"
      ]
    },
    "normative_function": {"type": ["string", "null"]},
    "source_excerpt": {"type": "string", "minLength": 1},
    "context_excerpt": {"type": ["string", "null"]},
    "interpretation": {"type": "string", "minLength": 1},
    "territorial_scope": {"type": ["string", "null"]},
    "conditions": {"type": "array", "items": {"type": "string"}},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "conflicts": {"type": "array", "items": {"type": "string"}},
    "source_trace": {
      "type": "object",
      "required": ["file_hash", "page_start", "article_label"],
      "properties": {
        "file_hash": {"type": "string", "minLength": 32},
        "page_start": {"type": "integer", "minimum": 1},
        "page_end": {"type": ["integer", "null"], "minimum": 1},
        "article_label": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "created_by": {"type": ["string", "null"]},
    "version": {"type": "integer", "minimum": 1, "default": 1}
  },
  "additionalProperties": false
}
